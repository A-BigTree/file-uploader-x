{
  "access": { "fs_read": false, "fs_write": false, "network": false },
  "common": [
    {
      "key": "format",
      "title": "输出格式",
      "description": "选择 markdown、HTML 或纯超链接",
      "config_type": "Default",
      "default_value": "markdown",
      "required": false,
      "form": {
        "type": "select",
        "multiple": false,
        "allow_custom": false,
        "options": [
          { "label": "Markdown", "value": "markdown" },
          { "label": "HTML", "value": "html" },
          { "label": "超链接", "value": "link" }
        ]
      }
    },
    {
      "key": "template",
      "title": "自定义模板",
      "description": "非空时覆盖输出格式，可使用 {url} {name} {size} {type}",
      "config_type": "Default",
      "default_value": "",
      "required": false,
      "form": { "type": "text", "secret": false, "max_len": 512 }
    }
  ],
  "groups": []
}
